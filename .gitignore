# Ignore folders, not single files. See AGENTS.md: art the game uses is committed; raw generations are not.

# Dependencies and builds
node_modules
dist
*.local
.DS_Store

# Local working data: test runs, renders, raw generated sheets, exports, the town builder's data
/output/
/backup/

# Other sessions' git worktrees inside this checkout: never track them
/.codex-session/
/.arcade-worktree/
/.built-worktree/

# Tool caches that land in the checkout
/Microsoft/

