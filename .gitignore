art/world/atlas.json
art/world/queue.json
art/world/layout/
art/world/prompts/
art/world/raw/
art/world/staged/
art/world/checks/
art/world/activations/
art/world/.pipeline.lock

# Art regen working files (results land in public/assets)
art/regen/raw/
art/regen/layout/
art/regen/log.txt
art/regen/run.*

# Raw generated UI sheets and review screenshots; the pieces the game uses are in public/images/
art/redesign/generated-v*/
