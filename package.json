{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/pack-release-assets.mjs",
    "preview": "vite preview",
    "art:export": "node scripts/export-art.mjs",
    "art:ui": "python3 scripts/crop-ui-kit.py",
    "art:world": "node scripts/world-art.mjs",
    "art:world:prepare": "node scripts/world-art.mjs prepare",
    "art:world:status": "node scripts/world-art.mjs status",
    "art:world:validate": "node scripts/world-art.mjs validate",
    "art:world:test": "node --test scripts/world-art.test.mjs",
    "test:expansion": "node --test scripts/expansion-store.test.mjs && node scripts/expansion.test.mjs",
    "test:expansion:media": "node scripts/expansion-media.test.mjs",
    "test:encounters": "node scripts/encounters.test.mjs",
    "test:boss-cycle": "node scripts/boss-cycle.test.mjs",
    "test:combat-rescue-store": "node scripts/combat-rescue-store.test.mjs",
    "test:costume-specials": "node --test scripts/enemy-affixes.test.mjs && node scripts/costume-specials.test.mjs",
    "test:production": "node scripts/production.test.mjs",
    "test:weapon-layout": "node scripts/weapon-layout.test.mjs",
    "test:pickup-layout": "node scripts/pickup-layout.test.mjs",
    "test:pickup-radius": "node scripts/pickup-radius.test.mjs",
    "test:bug-audit": "node scripts/bug-audit.test.mjs",
    "test:public-release": "node scripts/public-release.test.mjs",
    "test:run-purchase": "node scripts/run-purchase.test.mjs",
    "test:mobile": "node --test scripts/touch-input.test.mjs && node scripts/mobile.test.mjs",
    "test:house-guide-streets": "node --test scripts/street-geometry.test.mjs && node scripts/house-guide-streets.test.mjs",
    "test:presentation": "node scripts/presentation.test.mjs",
    "test:landing": "node scripts/landing.test.mjs",
    "test:outstanding": "node scripts/outstanding.test.mjs",
    "test:progression": "node --test scripts/progression.test.mjs && node scripts/progression-game.test.mjs",
    "art:presentation": "node scripts/prepare-presentation-art.mjs",
    "art:logo": "node scripts/prepare-logo.mjs",
    "art:weapon-cards": "node scripts/prepare-weapon-cards.mjs",
    "test:logo": "node scripts/logo-loading.test.mjs",
    "test:leaderboard": "node --test scripts/leaderboard.test.mjs && node scripts/leaderboard-ui.test.mjs",
    "test:leaderboard:production": "node scripts/leaderboard-production.test.mjs",
    "test:vending": "node --test scripts/vending-odds.test.mjs && node scripts/vending.test.mjs",
    "test:easy-wins": "node scripts/easy-wins.test.mjs",
    "test:map-rescue-break": "node scripts/map-rescue-break.test.mjs",
    "test:weapon-media": "node scripts/weapon-media.test.mjs",
    "audio:generate": "node scripts/generate-sounds.mjs"
  },
  "dependencies": {
    "@series-inc/rundot-game-sdk": "^5.24.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.53.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
