    "test:production": "node scripts/tests/production.test.mjs",
    "test:weapon-layout": "node scripts/tests/weapon-layout.test.mjs",
    "test:free-friend": "node scripts/tests/free-friend.test.mjs",
    "test:new-guns": "node scripts/tests/new-guns.test.mjs",
    "test:tap": "node scripts/tests/tap-to-interact.test.mjs",
    "test:earn-full-game": "node scripts/tests/earn-full-game.test.mjs",
    "test:first-door": "node scripts/tests/first-door-route.test.mjs",
    "test:boss-minions": "node scripts/tests/boss-minions.test.mjs",
    "test:loot": "node scripts/tests/loot-and-compare.test.mjs",
    "test:talents": "node scripts/tests/talent-finale.test.mjs && node scripts/tests/partner-talents.test.mjs",
    "test:own-costume": "node scripts/tests/own-costume.test.mjs",
    "art:hero3d:render": "node scripts/art/render-hero-3d.mjs",
    "test:hero3d-art": "node scripts/tests/hero3d-art.test.mjs",
    "test:pickup-layout": "node scripts/tests/pickup-layout.test.mjs",
    "test:pickup-radius": "node scripts/tests/pickup-radius.test.mjs",
    "test:bug-audit": "node scripts/tests/bug-audit.test.mjs",
    "test:public-release": "node scripts/tests/public-release.test.mjs",
    "test:run-purchase": "node scripts/tests/run-purchase.test.mjs",
    "test:mobile": "node --test scripts/tests/touch-input.test.mjs && node scripts/tests/mobile.test.mjs",
    "test:house-guide-streets": "node --test scripts/tests/street-geometry.test.mjs && node scripts/tests/house-guide-streets.test.mjs",
    "test:doors": "node scripts/tests/door-access.test.mjs",
    "test:presentation": "node scripts/tests/presentation.test.mjs",
    "test:landing": "node scripts/tests/landing.test.mjs",
    "test:outstanding": "node scripts/tests/outstanding.test.mjs",
    "test:progression": "node --test scripts/tests/progression.test.mjs && node scripts/tests/progression-game.test.mjs",
    "art:presentation": "node scripts/art/prepare-presentation-art.mjs",
    "art:logo": "node scripts/art/prepare-logo.mjs",
    "art:guns": "node scripts/art/prepare-gun-art.mjs",
    "art:treats": "node scripts/art/prepare-treat-art.mjs",
    "art:fx": "node scripts/art/prepare-fx-art.mjs",
    "art:talents": "node scripts/art/prepare-talent-art.mjs",
    "art:banner": "node scripts/art/prepare-banner-art.mjs",
    "art:badge": "node scripts/art/prepare-badge-art.mjs",
    "test:logo": "node scripts/tests/logo-loading.test.mjs",
    "test:leaderboard": "node --test scripts/tests/leaderboard.test.mjs && node scripts/tests/leaderboard-ui.test.mjs",
    "test:leaderboard:production": "node scripts/tests/leaderboard-production.test.mjs",
    "test:vending": "node --test scripts/tests/vending-odds.test.mjs && node scripts/tests/vending.test.mjs",
    "test:easy-wins": "node scripts/tests/easy-wins.test.mjs",
    "audio:generate": "node scripts/audio/generate-sounds.mjs",
    "test:map-navigation": "node scripts/tests/map-navigation.test.mjs",
    "test:ui-controls": "node scripts/tests/controls-records.test.mjs",
    "test:talent-camera": "node scripts/tests/talent-camera.test.mjs",
    "test:every-house": "node scripts/tests/every-house.test.mjs",
    "test:tutorial": "node scripts/tests/tutorial.test.mjs",
    "test:sfx-layers": "node --test scripts/tests/sfx-layers.test.mjs",
    "test:endless-talents": "node scripts/tests/endless-talents.test.mjs",
    "test:boss-prizes": "node scripts/tests/boss-prizes.test.mjs",
    "test:town-variations": "node --test scripts/town-variations/runner.test.mjs",
    "art:town-variations:slice": "node scripts/town-variations/slice.mjs"
  },
  "dependencies": {
    "@series-inc/rundot-game-sdk": "^5.24.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.53.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.1.17",
    "three": "^0.160.0",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
