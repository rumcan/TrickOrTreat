    "test:redesign": "node scripts/tests/redesign-screenshots.mjs --serve",
    "test:redesign:mobile": "node scripts/tests/redesign-screenshots.mjs --serve --quick --mobile",
    "test:typography": "node scripts/tests/typography-layout.test.mjs",
    "test:nightmare": "node scripts/tests/nightmare-art.test.mjs && node scripts/tests/nightmare-roster.test.mjs",
    "art:nightmare:export": "node scripts/art/nightmare-art.mjs export",
    "art:nightmare:pack": "node scripts/art/nightmare-art.mjs pack",
